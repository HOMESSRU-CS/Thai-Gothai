rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuth() { return request.auth != null; }
    function isAdmin() {
      return isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Places: public read, admin write
    match /places/{docId} {
      allow read: if true;
      allow write: if isAdmin();
      // Allow rating updates from authenticated users
      allow update: if isAuth() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'reviewCount']);
    }

    // Surveys: public create, admin read-all
    match /surveys/{docId} {
      allow create: if true; // Allow anonymous
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // Uploads: auth required to create, admin for full access
    match /uploads/{docId} {
      allow create: if isAuth();
      allow read: if isAdmin() || (isAuth() && resource.data.userId == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Users: users can read/update their own, admin sees all
    match /users/{userId} {
      allow read, write: if isAuth() && request.auth.uid == userId;
      allow read, write: if isAdmin();
      // Allow user creation on signup
      allow create: if isAuth() && request.auth.uid == userId;
    }
  }
}
